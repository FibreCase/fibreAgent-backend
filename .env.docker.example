# Copy to `.env.docker` and fill in your real values (or export them, or use
# docker-compose env vars). `.env.docker` is NOT git-ignored by pattern here —
# keep it out of the image via .dockerignore and never commit real values.
#
#   cp .env.docker.example .env.docker
#   docker run --rm --env-file .env.docker -v agent-data:/app/data fibrecase-agent-backend
#
# The app reads the same environment variables as it does locally. Only the
# three sections marked REQUIRED must be set for the container to start.

# --- OpenAI-compatible LLM (REQUIRED) ---------------------------------------
# NOTE: base_url is the API *prefix* — "…/v1", NOT the full "…/v1/chat/completions".
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT=120

# --- Telegram (REQUIRED) -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot.
# Everyone else is silently rejected.
TELEGRAM_ALLOWED_USER_IDS=

# --- Storage / behaviour -----------------------------------------------------
# Defaults to sqlite+aiosqlite:///./data/agent.db, which resolves to
# /app/data/agent.db in the container. Point the Docker volume at /app/data
# (see the run command / docker-compose.yaml) to persist across restarts.
# DATABASE_URL=sqlite+aiosqlite:///./data/agent.db

# System prompt file (shipped in the image at /app/config/). Leave as-is unless
# you bind-mount a different file into /app/config/.
# SYSTEM_PROMPT_PATH=config/system_prompt.txt
# Optional inline override that wins over the file:
# SYSTEM_PROMPT=

MAX_CONTEXT_MESSAGES=50
LOG_LEVEL=INFO
