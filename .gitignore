# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/
.ropeproject

# Virtual environments
.venv

# Secrets and local configuration — NEVER commit these
.env
.env.*
!.env.example

# Per-deployment MCP runtime config (which servers to connect to, and which
# tool permissions to grant). The app treats a missing file as "none" (no
# servers / no overrides), so a fresh clone runs without these. The example
# contents live inline in .env.example / docs/.
config/mcp_servers.json
config/mcp_permissions.json
config/infra_ssh_targets.json

# SSH credential files referenced by infra_ssh_targets.json (private key +
# known_hosts pin) — operator secrets, never committed (key-only, host-key-pinned).
config/id_*
config/ssh_known_hosts

# Local runtime data (SQLite database, etc.) — keep the dir via .gitkeep.
# This same data/ dir is also the Docker bind-mount source (compose: ./data:/app/data).
data/*
!data/.gitkeep
workspace/*
!workspace/.gitkeep

# Local temporary notes / task specs — not part of the project
TASK*.md
ROADMAP.md

# OS / editor noise
.DS_Store
