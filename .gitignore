# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/

# Virtual environments
.venv

# Secrets and local configuration — NEVER commit these
.env
.env.*
!.env.example

# Local runtime data (SQLite database, etc.) — keep the dir via .gitkeep
data/*
!data/.gitkeep

# Local SQLite store for the Docker bind mount (docker-compose.yaml: ./agent-data).
# Same data as data/, but kept out of git so a local `docker compose up` never
# commits the DB.
agent-data/

# Local temporary notes / task specs — not part of the project
TASK.md

# OS / editor noise
.DS_Store
