# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/

# Virtual environments
.venv

# Secrets and local configuration — NEVER commit these
.env
.env.*
!.env.example

# Local runtime data (SQLite database, etc.) — keep the dir via .gitkeep.
# This same data/ dir is also the Docker bind-mount source (compose: ./data:/app/data).
data/*
!data/.gitkeep

# Local temporary notes / task specs — not part of the project
TASK.md
ROADMAP.md

# OS / editor noise
.DS_Store
