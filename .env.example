# Copy this file to `.env` and fill in your real values.
#   cp .env.example .env
#
# `.env` and `data/` are git-ignored. Never commit real tokens or API keys.

# --- OpenAI-compatible LLM ---------------------------------------------------
# NOTE: base_url is the API *prefix*. The OpenAI SDK appends "/chat/completions",
# so this must be ".../v1", NOT the full ".../v1/chat/completions" URL.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT=120

# --- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot (e.g. "123456789,987654321").
# Everyone else is silently rejected (and logged server-side).
TELEGRAM_ALLOWED_USER_IDS=

# --- Storage / behaviour -----------------------------------------------------
# SQLite via aiosqlite. The parent directory (./data) is created automatically.
DATABASE_URL=sqlite+aiosqlite:///./data/agent.db

# Path to the system prompt file. A built-in fallback is used if missing.
SYSTEM_PROMPT_PATH=config/system_prompt.txt
# Optional: an inline system prompt that OVERRIDES the file if set.
# SYSTEM_PROMPT=

# Number of recent messages (not tokens) to include as context, plus the
# system prompt. Default 50.
MAX_CONTEXT_MESSAGES=50

# --- Context budget (phase 2.4) ---------------------------------------------
# Conservative, MODEL-AGNOSTIC estimate of the total prompt size (system +
# selected history + current user turn). This is a transparent *estimate* used
# for relative selection and protection — NOT a provider billing token count,
# and no model-specific tokenizer is involved. Default 24000.
MAX_CONTEXT_ESTIMATED_TOKENS=24000
# Estimated prompt cost attributed to each image kept in context. Default 2000.
# When a history turn's images won't fit the budget, that turn is downgraded to
# text-only (its images are dropped and never read from disk) rather than
# skipping a newer turn.
CONTEXT_IMAGE_ESTIMATED_TOKENS=2000

# --- Tools (phase 2) ---------------------------------------------------------
# Enable the tool-calling loop (get_current_time / echo / system_info). Set to
# false to fully disable tools and degrade to plain chat-only behaviour.
ENABLE_TOOLS=true
# Hard cap on LLM<->tool round-trips per message before a safe error is returned.
MAX_TOOL_ITERATIONS=5

# --- Tool security (phase 3) -------------------------------------------------
# Every tool call passes a policy → schema-validation → (optional one-time
# approval) → timeout → audited-execution gate. The read-only built-ins
# `get_current_time` and `echo` default to `allow` (no approval prompt);
# `system_info` is also read-only but is currently declared `ask` to exercise
# the approval flow (flip it back to `allow` in tools/builtin/system_info.py to
# restore approval-free behaviour). Any *future* tool defaults to `ask` so it
# can never run bare by accident.
#
# Per-tool permission overrides. Comma-separated <tool>=allow|ask|deny, e.g.
#   TOOL_PERMISSION_OVERRIDES=echo=deny,my_risky_tool=ask
# Empty (the default) uses each tool's declared default. A malformed entry, an
# unknown tool name, an illegal value, a duplicate tool, or a bad tool name is a
# startup ConfigError — a botched security setting is never silently ignored.
TOOL_PERMISSION_OVERRIDES=
# Seconds to wait for a Telegram Approve/Deny decision on an `ask` tool call
# before it expires (approval_expired). Must be > 0. Default 60.
TOOL_APPROVAL_TIMEOUT_SECONDS=60
# Maximum execution time for one tool invocation; on timeout the tool is
# cancelled and the model is told it timed out (tool_timeout). Must be > 0.
# Default 30.
TOOL_TIMEOUT_SECONDS=30
# (No separate flag is needed to enable the audit log: it is on whenever
# ENABLE_TOOLS=true, and every event is viewable via /tool_audit.)

# --- Remote MCP tools (phase 4, Streamable HTTP) ----------------------------
# Optional: connect to remote Model Context Protocol servers and expose their
# tools. Each MCP tool rides the *entire* phase-3 gate (policy → schema
# validation → optional one-time approval → timeout → audit) exactly like a
# built-in — MCP is a tool *provider*, not a new execution path. Every
# discovered tool is namespaced `mcp_<server>__<remote>` and defaults to `ask`
# (override per namespaced name via TOOL_PERMISSION_OVERRIDES above).
#
# A JSON *array* of server objects. Empty (the default) = no MCP servers, so no
# MCP client is created and no MCP network connection is ever made. Each object:
#   { "name": "alpha",
#     "url": "https://mcp.example/sse",            # absolute https (see below)
#     "bearer_token_env": "MCP_TOKEN_ALPHA" }      # optional env-var NAME
#
# Rules (all enforced at startup; a violation is a ConfigError, never a
# silent drop):
#   * name — lowercase start, [a-z][a-z0-9_-]{0,31}; must be unique.
#   * url  — absolute https:// with a host, and no userinfo/fragment/query.
#            http:// is refused unless MCP_ALLOW_INSECURE_HTTP=true (trusted
#            local/private endpoints only).
#   * bearer_token_env — the *name* of an env var holding the token (read at
#            startup as an Authorization: Bearer header). It must be set and
#            non-empty; the token value is env-only and never logged or stored.
# Example (two servers, one authenticated):
#   MCP_SERVERS=[{"name":"alpha","url":"https://a.example/mcp"},{"name":"beta","url":"https://b.example/mcp","bearer_token_env":"MCP_TOKEN_BETA"}]
MCP_SERVERS=
# Seconds to wait for the initial connect/initialize/tools-list handshake per
# server before it is marked unavailable (the rest of the bot still starts).
# Must be > 0. Default 10.
MCP_CONNECT_TIMEOUT_SECONDS=10
# Hard cap on how many characters of *text* one remote MCP tool result may
# return to the model. A larger result is refused with a stable
# mcp_result_too_large code (never truncated, never echoed). Must be >= 1.
# Default 10000.
MAX_MCP_TOOL_RESULT_CHARS=10000
# Hard opt-in to plain http:// endpoints (off by default → https only). Set true
# only for a trusted local/private endpoint you control.
MCP_ALLOW_INSECURE_HTTP=false
# (Status of the configured servers is viewable via the /mcp_status command;
# it is read-only and never connects, refreshes, or calls the LLM/MCP.)

# --- User-level OAuth for MCP servers (phase 4.x) ---------------------------
# Optional: let *you* (a Telegram user) log in to a third-party account (first
# consumer: Google Calendar) so an MCP server that requires user-level OAuth
# can act on YOUR behalf. The credential binds to your Telegram user id — it
# survives /new, /start, and restarts, and is NEVER shared across users.
#
# Everything OAuth is off unless OAUTH_CALLBACK_BASE_URL is set.
#
# The PUBLIC origin the OAuth provider redirects back to. It must be an
# absolute http(s) origin with a host and NO path / query / fragment / trailing
# slash (a violation is a startup ConfigError). The full redirect URI the
# provider calls is <OAUTH_CALLBACK_BASE_URL>/oauth/callback — e.g. if you set
# https://oauth.example.com, Google must be able to reach
# https://oauth.example.com/oauth/callback. Register that exact redirect URI in
# your Google Cloud OAuth client.
# OAUTH_CALLBACK_BASE_URL=
# TCP port the minimal callback HTTP server listens on while OAuth is
# configured. Must be 1..65535. Default 8090.
# NOTE (Docker): the app is outbound-only by default and the base
# docker-compose.yaml publishes NO ports. When you enable OAuth, ALSO add the
# opt-in override that publishes this port, or the provider can't reach the
# callback:  docker compose -f docker-compose.yaml -f docker-compose.oauth.yaml up
# OAUTH_CALLBACK_PORT=8090
# How long an in-flight authorization state stays valid (seconds) before the
# link expires. Must be > 0. Default 600.
# OAUTH_STATE_TTL_SECONDS=600
#
# Google provider credentials (read ONLY by the composition root, only for the
# "google" provider — never stored on config, never logged). A client id or
# secret left unset means the google provider is not configured, and an MCP
# server requesting provider "google" is marked unavailable with a stable
# (log-only) code instead of the bot failing to start.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# OAuth scopes, whitespace-separated (e.g. two scopes = two space-separated
# URLs). Empty (the default) means the Google Calendar read-only scope.
# GOOGLE_OAUTH_SCOPES=
#
# Tie an MCP server to user-level OAuth via its "authentication" field —
# mutually exclusive with "bearer_token_env":
#   {"name":"gcal","url":"https://g.example/mcp",
#    "authentication":{"type":"oauth","provider":"google"}}
# Start a login from Telegram with:  /mcp auth <server-name>

# --- Multimodal input (phase 2.1.x) ------------------------------------------
# Maximum image size (in MB) that a Telegram photo may be before it is refused
# with a user-friendly error (rather than sent to the LLM). Default 10.
MAX_IMAGE_SIZE_MB=10

# --- Persistent image attachments (phase 2.2) --------------------------------
# Root directory for persistent, content-addressed image attachment blobs.
# Relative paths stay relative to the working directory. The directory is
# created on demand. Under Docker the default ./data/attachments is covered by
# the ./data:/app/data bind mount. Image bytes are NOT written to the database
# (only metadata is); they live here, deduplicated by SHA-256.
ATTACHMENT_STORAGE_PATH=./data/attachments

# --- Explicit long-term memory (phase 2.5) ----------------------------------
# The owner saves discrete facts via /remember (never auto-extracted from chat).
# On a normal text message the backend deterministically retrieves relevant
# memories (pure lexical search, no embeddings/FTS5) and, if they fit, injects
# them as a separate, clearly-marked reference system message.
#
# Maximum number of saved memories per account (scope). Default 200.
MAX_MEMORIES_PER_SCOPE=200
# Maximum length (chars, after trim) of one saved memory. Longer is refused
# with a user-safe "memory_invalid" reply. Default 1000.
MAX_MEMORY_CHARS=1000
# Maximum number of relevant memories retrieved (and eligible for injection)
# per message. Default 5.
MAX_RETRIEVED_MEMORIES=5
# Conservative, MODEL-AGNOSTIC estimated-token *sub-budget* for injected memory
# (same estimate units as MAX_CONTEXT_ESTIMATED_TOKENS — NOT a billing count).
# A memory that would push the reference message over this sub-budget is skipped
# (never truncated). It must be <= MAX_CONTEXT_ESTIMATED_TOKENS. Default 3000.
MAX_MEMORY_ESTIMATED_TOKENS=3000

# Logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Colourise the log level tag (INFO green / WARNING yellow / ERROR red).
# auto (default): colour only when running in a terminal, so piped/redirected
# logs (e.g. `docker logs`, a log file) stay plain text. true = always colour,
# false = never colour.
LOG_COLOR=auto

# --- Docker only (not read by the app) --------------------------------------
# docker-compose runs the container as your host uid/gid so the bind-mounted
# ./data keeps normal host permissions while staying writable by the container.
# Find your values with:  id -u   and   id -g
#   (typical: Linux first user = 1000, macOS default user = 501)
HOST_UID=1000
HOST_GID=1000

# Container timezone. The image defaults to UTC, so without this the app's
# local time (get_current_time, log timestamps) is off from your wall clock.
# IANA zone, e.g. Asia/Shanghai. compose reads this for the container's TZ.
# (Only affects Docker — a plain `uv run` on the host already uses the host TZ.)
TZ=Asia/Shanghai
