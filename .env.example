# Copy to `.env` and fill in your real values:
#   cp .env.example .env
#
# `.env` and `data/` are git-ignored — never commit real tokens or API keys.
# Full reference (every variable: explanation / example / default): docs/configuration.md

# --- OpenAI-compatible LLM ---------------------------------------------------
# API *prefix* only — the SDK appends "/chat/completions", so use ".../v1",
# NOT the full ".../v1/chat/completions" URL.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT=120

# --- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated allowed Telegram user IDs; everyone else is silently rejected.
TELEGRAM_ALLOWED_USER_IDS=

# --- Storage / behaviour -----------------------------------------------------
# Parent directory (./data) is created automatically.
DATABASE_URL=sqlite+aiosqlite:///./data/agent.db
SYSTEM_PROMPT_PATH=config/system_prompt.txt
# Optional inline system prompt; OVERRIDES the file if set.
# SYSTEM_PROMPT=
# Recent messages (not tokens) included as context, plus the system prompt.
MAX_CONTEXT_MESSAGES=50

# --- Context budget ----------------------------------------------------------
# Model-agnostic *estimate* of total prompt size — a protection estimate, NOT
# a provider billing token count.
MAX_CONTEXT_ESTIMATED_TOKENS=200000
# Estimated cost attributed to each image kept in context.
CONTEXT_IMAGE_ESTIMATED_TOKENS=2000

# --- Tools -------------------------------------------------------------------
# false = fully degrade to plain chat-only behaviour.
ENABLE_TOOLS=true
# Hard cap on LLM<->tool round-trips per message.
MAX_TOOL_ITERATIONS=20

# --- Tool security -----------------------------------------------------------
# Seconds to wait for a Telegram Approve/Deny on an `ask` tool before it expires.
TOOL_APPROVAL_TIMEOUT_SECONDS=60
# Max execution time for one tool call; on timeout it is cancelled.
TOOL_TIMEOUT_SECONDS=30
# (No flag enables the audit log: it is on whenever ENABLE_TOOLS=true, viewable via /tool_audit.)

# --- Exec shell tool (opt-in, OFF by default) --------------------------------
# /bin/sh -c, always `ask` (command shown verbatim on the approval card), with a
# static catastrophic-command backstop. Needs ENABLE_TOOLS=true to register.
ENABLE_EXEC_TOOL=false
# MAX_EXEC_TOOL_RESULT_CHARS=8000
# EXEC_WORKDIR=./scratch
# EXEC_POLICY_DENY_PATTERNS=["\\bdocker\\b","\\bkubectl\\b"]

# --- Edit file tool (opt-in, OFF by default) ---------------------------------
# read / precise-replace a UTF-8 file inside EDIT_WORKDIR, always `ask`, confined
# to EDIT_WORKDIR (../ and symlink escapes refused). Needs ENABLE_TOOLS=true.
ENABLE_EDIT_TOOL=false
# EDIT_WORKDIR=./scratch        # REQUIRED when enabled
# MAX_EDIT_STRING_CHARS=2000
# MAX_EDIT_READ_CHARS=8000

# --- Remote MCP tools (Streamable HTTP + stdio) ------------------------------
# JSON array of servers; empty = no MCP client, connection, or process.
#   MCP_SERVERS=[{"name":"alpha","url":"https://a.example/mcp"},{"name":"fs","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}]
MCP_SERVERS=
# PREFERRED for multiple/stdio servers: a standalone file holding the same array;
# wins over MCP_SERVERS when set.
# MCP_SERVERS_FILE=config/mcp_servers.json
# Dedicated MCP-tool permission overrides (JSON array file); hot-reloaded.
# MCP_PERMISSIONS_FILE=config/mcp_permissions.json
MCP_CONNECT_TIMEOUT_SECONDS=10
MAX_MCP_TOOL_RESULT_CHARS=10000
# Allow plain http:// endpoints (trusted local/private only). HTTP transport only.
MCP_ALLOW_INSECURE_HTTP=false

# --- User-level OAuth for MCP (OFF unless OAUTH_CALLBACK_BASE_URL is set) ----
# PUBLIC origin the provider redirects to; the full redirect URI is <base>/oauth/callback
# (must be publicly reachable and registered with the provider).
# OAUTH_CALLBACK_BASE_URL=https://oauth.example.com
# OAUTH_CALLBACK_PORT=8090
# OAUTH_STATE_TTL_SECONDS=600
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_SCOPES=

# --- Read-only infrastructure observation over SSH ---------------------------
# JSON array of targets (Linux + systemd); empty = no provider, no SSH connection.
#   INFRA_SSH_TARGETS=[{"name":"nas","host":"nas.local","port":22,"username":"probe","private_key_path":"config/id_nas","known_hosts_path":"config/ssh_known_hosts","mounts":["/volume1"],"services":["ssh.service"]}]
# INFRA_SSH_TARGETS=
# PREFERRED for multiple targets / a mounted key: a standalone file; wins over the
# default file and the inline value when set.
# INFRA_SSH_TARGETS_FILE=config/infra_ssh_targets.json
# INFRA_SSH_CONNECT_TIMEOUT_SECONDS=10
# MAX_INFRA_TOOL_RESULT_CHARS=8000

# --- Multimodal input ---------------------------------------------------------
# Max Telegram photo size (MB) before it is refused.
MAX_IMAGE_SIZE_MB=10

# --- Persistent image attachments --------------------------------------------
ATTACHMENT_STORAGE_PATH=./data/attachments

# --- Explicit long-term memory -----------------------------------------------
MAX_MEMORIES_PER_SCOPE=200
MAX_MEMORY_CHARS=1000
MAX_RETRIEVED_MEMORIES=5
# Estimated-token sub-budget for injected memory (<= MAX_CONTEXT_ESTIMATED_TOKENS).
MAX_MEMORY_ESTIMATED_TOKENS=3000

# --- Logging -----------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# auto (colour only in a terminal) / true / false.
LOG_COLOR=auto

# --- Docker only (not read by the app) ---------------------------------------
# Container runs as your host uid/gid so bind-mounted ./data stays writable.
# Find values with:  id -u   and   id -g
HOST_UID=1000
HOST_GID=1000
# Container timezone (IANA); the image defaults to UTC.
TZ=Asia/Shanghai
