# Copy this file to `.env` and fill in your real values.
#   cp .env.example .env
#
# `.env` and `data/` are git-ignored. Never commit real tokens or API keys.

# --- OpenAI-compatible LLM ---------------------------------------------------
# NOTE: base_url is the API *prefix*. The OpenAI SDK appends "/chat/completions",
# so this must be ".../v1", NOT the full ".../v1/chat/completions" URL.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT=120

# --- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot (e.g. "123456789,987654321").
# Everyone else is silently rejected (and logged server-side).
TELEGRAM_ALLOWED_USER_IDS=

# --- Storage / behaviour -----------------------------------------------------
# SQLite via aiosqlite. The parent directory (./data) is created automatically.
DATABASE_URL=sqlite+aiosqlite:///./data/agent.db

# Path to the system prompt file. A built-in fallback is used if missing.
SYSTEM_PROMPT_PATH=config/system_prompt.txt
# Optional: an inline system prompt that OVERRIDES the file if set.
# SYSTEM_PROMPT=

# Number of recent messages (not tokens) to include as context, plus the
# system prompt. Default 50.
MAX_CONTEXT_MESSAGES=50

# Logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# --- Docker only (not read by the app) --------------------------------------
# docker-compose runs the container as your host uid/gid so the bind-mounted
# ./data keeps normal host permissions while staying writable by the container.
# Find your values with:  id -u   and   id -g
#   (typical: Linux first user = 1000, macOS default user = 501)
HOST_UID=1000
HOST_GID=1000
